#!/bin/sh

# Resolve the repo root from git rather than relying on $0's relative path,
# which breaks after any cd inside this script. (#920)
ROOT=$(git rev-parse --show-toplevel)

echo "--- Frontend build ---"
cd "$ROOT"
# A production build now fails fast if NEXT_PUBLIC_API_URL is unset (#675) —
# this hook only verifies the build itself succeeds, not real backend
# connectivity, so a placeholder is enough here.
NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL:-https://api.pre-push-placeholder.example}" npm run build
if [ $? -ne 0 ]; then
  echo "FAILED: Frontend build"
  exit 1
fi
echo "PASSED: Frontend build"
