# ============================================================
# C-Address Bridge — environment variable reference (#902)
#
# Copy this file to .env.local and fill in the values you need:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the
# browser bundle by Next.js — never put secrets there.
# Variables without that prefix are server-side only.
# ============================================================

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Which Stellar network to target.  TESTNET or PUBLIC.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------

# Base URL of the C-Address Bridge backend.  Required in production; the
# build fails immediately if this is unset when NODE_ENV=production (#675).
# Falls back to a placeholder in dev/test so you don't need it just to run
# `npm test`.  Also used by the server-side proxy routes under
# src/app/api/backend/ to know where to forward requests.
NEXT_PUBLIC_API_URL=

# The backend's X-API-Key.  Attached server-side only by the proxy routes
# under src/app/api/backend/ — never use a NEXT_PUBLIC_* name for this or
# it will be published to every visitor's browser (#674).
# A request to any proxy route returns 500 if this is unset.
BACKEND_API_KEY=

# ---------------------------------------------------------------------------
# Soroban RPC
# ---------------------------------------------------------------------------

# Soroban RPC endpoint for Testnet.
# Defaults to the official SDF endpoint; override only if you use a custom provider.
NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org

# Soroban RPC endpoint for Mainnet (PUBLIC network).
# The SDF does not operate a free public mainnet Soroban RPC.
# Soroban calls on PUBLIC fail with a clear error until this is set.
NEXT_PUBLIC_SOROBAN_RPC_URL_PUBLIC=

# Alternate names used by the middleware CSP builder (same values as above).
# Set these to the same URLs if you use custom Soroban RPC endpoints.
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_SOROBAN_RPC_TESTNET_URL=
NEXT_PUBLIC_SOROBAN_RPC_MAINNET_URL=

# ---------------------------------------------------------------------------
# Horizon
# ---------------------------------------------------------------------------

# Horizon base URL for Mainnet.  Defaults to the official SDF endpoint.
# Override only if you use a custom Horizon provider.
NEXT_PUBLIC_HORIZON_URL_PUBLIC=https://horizon.stellar.org

# Horizon base URL for Testnet.  Defaults to the official SDF endpoint.
NEXT_PUBLIC_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Contracts
# ---------------------------------------------------------------------------

# Soroban bridge contract address (C-address).  Omits the direct-payment
# path when unset.
NEXT_PUBLIC_BRIDGE_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Onramp providers
# ---------------------------------------------------------------------------

# Moonpay public API key.  Required to enable the Moonpay onramp flow.
NEXT_PUBLIC_MOONPAY_API_KEY=

# Transak public API key.  Required to enable the Transak onramp flow.
NEXT_PUBLIC_TRANSAK_API_KEY=

# ---------------------------------------------------------------------------
# CEX deposit routing
# ---------------------------------------------------------------------------

# Bridge deposit address shown to users for CEX withdrawal routing.
NEXT_PUBLIC_CEX_BRIDGE_DEPOSIT_ADDRESS=

# ---------------------------------------------------------------------------
# Widget
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to embed the widget via postMessage.
# Example: https://partner1.example.com,https://partner2.example.com
NEXT_PUBLIC_WIDGET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Service worker
# ---------------------------------------------------------------------------

# Set to "true" to enable the caching service worker in production builds.
# The SW is disabled by default.
NEXT_PUBLIC_ENABLE_SW=false

# ---------------------------------------------------------------------------
# Performance budget
# ---------------------------------------------------------------------------

# Initial JS budget in KB.  Defaults to 700.  Overrides the value in
# next.config.ts for a single build without editing the file.
NEXT_PUBLIC_INITIAL_JS_BUDGET_KB=700

# ---------------------------------------------------------------------------
# Site metadata
# ---------------------------------------------------------------------------

# Canonical site URL, used by the sitemap and robots.txt generators.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# ---------------------------------------------------------------------------
# Transaction status
# ---------------------------------------------------------------------------

# URL used by stellar.ts to poll transaction status after submission.
# Defaults to /api/transactions (the local Next.js route).
NEXT_PUBLIC_TRANSACTION_STATUS_URL=

# ---------------------------------------------------------------------------
# Activity / indexer
# ---------------------------------------------------------------------------

# URL for the indexer events endpoint used by the activity feed API route.
# Required for the recent-activity feed to return real data.
INDEXER_EVENTS_URL=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Comma-separated list of feature flag overrides, e.g. "locked_transfers=true".
# Applied client-side at runtime.
NEXT_PUBLIC_FEATURE_FLAGS=

# JSON object of feature flag overrides evaluated server-side by the
# /api/feature-flags route, e.g. '{"locked_transfers":true}'.
FEATURE_FLAGS_JSON=
