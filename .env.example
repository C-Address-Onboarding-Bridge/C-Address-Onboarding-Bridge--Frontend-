# .env.example — template for local development
#
# Copy this file to .env.local and fill in the values you need:
#   cp .env.example .env.local
#
# .env.local is gitignored and will never be committed.
# This file IS committed so contributors know what to configure.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle.
# Never put secrets in NEXT_PUBLIC_* variables.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Stellar network to target. Must be "TESTNET" or "PUBLIC".
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------

# Base URL of the C-Address Bridge backend.
# Required in production — the build fails immediately if this is unset
# when NODE_ENV=production (#675). Falls back to a placeholder in dev/test.
# Also the target that the server-side proxy routes forward to.
NEXT_PUBLIC_API_URL=

# The backend's X-API-Key, attached server-side only by the proxy routes
# under src/app/api/backend/ (#674). Never put this in a NEXT_PUBLIC_* var —
# that would publish it to every visitor's browser bundle.
# A request to any proxy route returns 500 if this is unset.
BACKEND_API_KEY=

# ---------------------------------------------------------------------------
# Soroban RPC endpoints
# ---------------------------------------------------------------------------

# Soroban RPC endpoint for Testnet.
# Defaults to the official SDF endpoint https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=

# Soroban RPC endpoint for Mainnet (PUBLIC).
# SDF does not operate a free public mainnet Soroban RPC — set this to your
# own provider's URL. Soroban RPC calls on PUBLIC fail with a clear
# configuration error until this is set.
NEXT_PUBLIC_SOROBAN_RPC_URL_PUBLIC=

# CSP middleware also reads these aliases for allow-listing the RPC origins.
# Set these if your setup uses different variable names for the RPC URLs.
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_SOROBAN_RPC_TESTNET_URL=
NEXT_PUBLIC_SOROBAN_RPC_MAINNET_URL=

# ---------------------------------------------------------------------------
# Horizon endpoints (optional overrides)
# ---------------------------------------------------------------------------

# Horizon URLs default to the official SDF endpoints and are usually
# hardcoded constants in src/lib/types.ts. Override here if you need to
# point at a custom Horizon instance.
NEXT_PUBLIC_HORIZON_URL_PUBLIC=
NEXT_PUBLIC_HORIZON_URL_TESTNET=

# ---------------------------------------------------------------------------
# Soroban bridge contract
# ---------------------------------------------------------------------------

# Soroban bridge contract ID. When unset, the direct-payment fallback is used.
NEXT_PUBLIC_BRIDGE_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Fiat onramp providers
# ---------------------------------------------------------------------------

# Moonpay public API key. Required to show Moonpay as an onramp option.
# Obtain from https://buy.moonpay.com
NEXT_PUBLIC_MOONPAY_API_KEY=

# Transak public API key. Required to show Transak as an onramp option.
# Obtain from https://global.transak.com
NEXT_PUBLIC_TRANSAK_API_KEY=

# ---------------------------------------------------------------------------
# CEX / widget
# ---------------------------------------------------------------------------

# CEX bridge deposit address. When set, the CEX routing UI shows this
# address as the bridge deposit target.
NEXT_PUBLIC_CEX_BRIDGE_DEPOSIT_ADDRESS=

# Comma-separated list of allowed origins for the embeddable widget
# (checked against the parent frame's origin). Leave blank to disallow all.
NEXT_PUBLIC_WIDGET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Service Worker
# ---------------------------------------------------------------------------

# Set to "true" to enable the service worker for asset caching.
# Defaults to disabled.
NEXT_PUBLIC_ENABLE_SW=

# ---------------------------------------------------------------------------
# SEO / site metadata
# ---------------------------------------------------------------------------

# Canonical site URL used for sitemap.xml and robots.txt generation.
# Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Transaction status
# ---------------------------------------------------------------------------

# URL used to poll for transaction status. Defaults to the same-origin
# /api/transactions route. Override to point at a different status endpoint.
NEXT_PUBLIC_TRANSACTION_STATUS_URL=

# ---------------------------------------------------------------------------
# Feature flags (server-side override)
# ---------------------------------------------------------------------------

# JSON array of FeatureFlag objects to override the bundled defaults.
# If unset or invalid, the bundled defaults are used.
# Example: FEATURE_FLAGS_JSON=[{"id":"locked_transfers","enabled":true}]
FEATURE_FLAGS_JSON=

# Client-side feature flags string (read by src/lib/featureFlags.ts).
# Format matches the server-side FEATURE_FLAGS_JSON but is inlined into
# the browser bundle — do not include sensitive values.
NEXT_PUBLIC_FEATURE_FLAGS=

# ---------------------------------------------------------------------------
# Activity feed / indexer
# ---------------------------------------------------------------------------

# URL of the activity indexer events endpoint (server-side only).
# When unset, the /api/activity route returns an empty array instead of
# making a network request.
INDEXER_EVENTS_URL=

# ---------------------------------------------------------------------------
# Bundle budget (build-time only)
# ---------------------------------------------------------------------------

# Override the initial JS bundle budget in KB. Defaults to 700.
# Useful for temporary overrides during development without editing
# next.config.ts. This is a build-time variable — it is NOT sent to the browser
# even though it has the NEXT_PUBLIC_ prefix (it's only read during the build).
NEXT_PUBLIC_INITIAL_JS_BUDGET_KB=
